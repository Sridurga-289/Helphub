# Copy this file to .env, then replace the Atlas placeholders with your values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/helphub?retryWrites=true&w=majority
MONGODB_DATABASE=helphub
PORT=3000
# Replace with a long private token before enabling organizer tools.
ADMIN_TOKEN=<choose-a-long-random-token>
